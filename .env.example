# Public application configuration
NEXT_PUBLIC_APP_NAME=ANCHOR
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for live Gemma and Gemini calls
GEMINI_API_KEY=

# Model selection
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMINI_VALIDATION_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_VIDEO_MODEL=gemini-omni-flash-preview

# Local hackathon persistence
ANCHOR_STORAGE_MODE=local
ANCHOR_DATA_DIR=.data

# Demo and feature flags
ANCHOR_DEMO_MODE=true
ANCHOR_LIVE_MEDIA_IN_DEMO=false
ANCHOR_ENABLE_IMAGE_GENERATION=true
ANCHOR_ENABLE_VIDEO_GENERATION=true
NEXT_PUBLIC_ENABLE_SPEECH_RECOGNITION=false

# Operational limits
ANCHOR_AI_TIMEOUT_MS=45000
ANCHOR_VIDEO_TIMEOUT_MS=180000
ANCHOR_MAX_UPLOAD_MB=10
